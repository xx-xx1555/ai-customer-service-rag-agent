APP_NAME=智能客服知识库与工单分析平台
APP_VERSION=0.7.0
DEBUG=false
SKIP_INDEX_ON_STARTUP=false
INDEX_STARTUP_RETRIES=5
INDEX_RETRY_DELAY_SECONDS=2
CORS_ORIGINS=*

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

UPLOAD_DIR=storage
TICKET_FILE=data/tickets.csv
DATABASE_URL=postgresql+psycopg://ai_agent:ai_agent_password@localhost:15432/ai_agent
DATABASE_ECHO=false
AUTO_CREATE_TABLES=true
AUTO_SEED_TICKETS=true

# Docker Compose 本地演示账号。公开部署时请务必修改密码。
POSTGRES_DB=ai_agent
POSTGRES_USER=ai_agent
POSTGRES_PASSWORD=ai_agent_password
API_PORT=18000
FRONTEND_PORT=8501

CHUNK_SIZE=500
CHUNK_OVERLAP=80
DEFAULT_TOP_K=4
DEFAULT_MIN_SCORE=0.02

EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
EMBEDDING_QUERY_INSTRUCTION=为这个句子生成表示以用于检索相关文章：

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge_chunks
QDRANT_TIMEOUT=30
QDRANT_UPLOAD_BATCH_SIZE=64
QDRANT_LOCAL_PATH=

DENSE_WEIGHT=0.70
BM25_WEIGHT=0.30

RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_DEVICE=cpu
RERANKER_BATCH_SIZE=16
RERANKER_CANDIDATE_MULTIPLIER=5
RERANKER_WEIGHT=0.85
RERANKER_FAIL_OPEN=true

AGENT_MAX_TOOL_CALLS=4
AGENT_USE_LLM_PLANNER=true
AGENT_DEFAULT_RERANK=true
